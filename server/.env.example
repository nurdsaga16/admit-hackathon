# Copy to server/.env. Loaded relative to index.mjs, independently of cwd.
# Existing process environment wins. Restart Node after editing.
# Without .env: default Google STUN, no TURN, policy all.
# Vite proxies /api and /signal during development.
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
STUN_URLS=stun:stun.l.google.com:19302
# Two devices require trusted HTTPS (reverse proxy, or certificates below).
# HOST=0.0.0.0
# TLS_CERT_FILE=C:/certs/signbridge.pem
# TLS_KEY_FILE=C:/certs/signbridge-key.pem
# ALLOWED_ORIGINS=https://signbridge.example
# For Quick Tunnel use its actual HTTPS origin; update when its hostname changes.
# coturn REST credentials: only short-lived credentials reach the browser.
# Actual turn:/turns: endpoints, NOT the Quick Tunnel HTTPS URL.
# Secret must equal coturn static-auth-secret, not an ordinary account password.
# No TURN service or credentials are bundled. See docs/CALL.md.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=3600
# all or relay; relay is useful for testing TURN.
ICE_TRANSPORT_POLICY=all
MAX_ROOMS=1000
